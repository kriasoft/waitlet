{
  "name": "waitlet",
  "version": "0.1.0",
  "description": "Limit how many AI coding agents run at once: Claude Code, Codex and Superset agents take a slot, wait in a queue, and continue when one frees up.",
  "keywords": [
    "agentic-coding",
    "ai",
    "ai-agents",
    "claude",
    "claude-code",
    "cli",
    "codex",
    "coding-agents",
    "concurrency",
    "concurrency-limit",
    "lease",
    "lock",
    "mutex",
    "queue",
    "semaphore",
    "sqlite",
    "superset",
    "throttle"
  ],
  "homepage": "https://kriasoft.com/waitlet/",
  "bugs": "https://github.com/kriasoft/waitlet/issues",
  "license": "MIT",
  "author": "Konstantin Tarkus <koistya@kriasoft.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kriasoft/waitlet.git"
  },
  "bin": {
    "waitlet": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/cli.ts --target=node --outdir dist && tsc -p tsconfig.build.json && rm dist/cli.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-llms": "1.14.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "bun@1.4.4"
}
